diff --git a/src/plugins/screencast/screencastlayer.cpp b/src/plugins/screencast/screencastlayer.cpp
index 7b2187fedd2fca1d3e80a6ee5b23a10487e56579..df631b960408b65c5a14f68fa3167143104a4a23 100644
