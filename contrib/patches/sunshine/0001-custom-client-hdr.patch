diff --git a/src/platform/linux/pipewire_hdr.h b/src/platform/linux/pipewire_hdr.h
new file mode 100644
index 0000000000000000000000000000000000000000..be44530bd9a348dd23c735d73c0fb4021b26a9a3
--- /dev/null
+++ b/src/platform/linux/pipewire_hdr.h
@@ -0,0 +1,52 @@
+/**
+ * @file src/platform/linux/pipewire_hdr.h
+ * @brief Per-client HDR color-tag policy for PipeWire format negotiation.
+ */
+#pragma once
+
+// lib includes
+#include <pipewire/version.h>
+#include <spa/param/video/format-utils.h>
+#include <spa/pod/builder.h>
+
+namespace pipewire {
+  /**
+   * @brief Select explicit SDR or HDR color tags independently of buffer bit depth.
+   * @param format PipeWire video format being advertised.
+   * @param want_hdr Whether the streaming client requested HDR.
+   * @return Requested primaries and transfer function for this format.
+   */
+  constexpr auto capture_color_tags(int format, bool want_hdr) {
+    struct color_tags_t {
+      spa_video_color_primaries primaries;  ///< Requested color primaries.
+      spa_video_transfer_function transfer;  ///< Requested transfer function.
+    };
+
+    const bool ten_bit = format == SPA_VIDEO_FORMAT_xBGR_210LE ||
+                         format == SPA_VIDEO_FORMAT_ARGB_210LE ||
+                         format == SPA_VIDEO_FORMAT_ABGR_210LE ||
+                         format == SPA_VIDEO_FORMAT_RGBA_102LE ||
+                         format == SPA_VIDEO_FORMAT_BGRA_102LE;
+#if PW_CHECK_VERSION(1, 6, 0)
+    constexpr auto pq = SPA_VIDEO_TRANSFER_SMPTE2084;
+#else
+    // PipeWire's stable wire value predates the public enum name.
+    constexpr auto pq = static_cast<spa_video_transfer_function>(14);
+#endif
+    return want_hdr && ten_bit ?
+             color_tags_t {SPA_VIDEO_COLOR_PRIMARIES_BT2020, pq} :
+             color_tags_t {SPA_VIDEO_COLOR_PRIMARIES_BT709, SPA_VIDEO_TRANSFER_GAMMA22};
+  }
+
+  /**
+   * @brief Add the explicit color choice to the actual PipeWire format offer.
+   * @param builder Builder positioned inside a video format object.
+   * @param format PipeWire video format being advertised.
+   * @param want_hdr Whether the streaming client requested HDR.
+   */
+  inline void add_capture_color_tags(spa_pod_builder *builder, int format, bool want_hdr) {
+    const auto tags = capture_color_tags(format, want_hdr);
+    spa_pod_builder_add(builder, SPA_FORMAT_VIDEO_colorPrimaries, SPA_POD_Id(tags.primaries), 0);
+    spa_pod_builder_add(builder, SPA_FORMAT_VIDEO_transferFunction, SPA_POD_Id(tags.transfer), 0);
+  }
+}  // namespace pipewire
