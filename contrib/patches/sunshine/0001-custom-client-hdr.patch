--- /dev/null
+++ b/tests/unit/platform/linux/test_pipewire_hdr.cpp
@@ -0,0 +1,37 @@
+/**
+ * @file tests/unit/platform/linux/test_pipewire_hdr.cpp
+ * @brief Regression tests for per-client PipeWire HDR color tags.
+ */
+#if defined(SUNSHINE_BUILD_KWIN) || defined(SUNSHINE_BUILD_PORTAL)
+  // test includes
+  #include "../../../tests_common.h"
+
+  // local includes
+  #include "src/platform/linux/pipewire_hdr.h"
+
+TEST(PipeWireHdr, EverySupportedFormatExplicitlyNegotiatesClientColorTags) {
+  const int formats[] = {SPA_VIDEO_FORMAT_xBGR_210LE, SPA_VIDEO_FORMAT_ARGB_210LE, SPA_VIDEO_FORMAT_ABGR_210LE, SPA_VIDEO_FORMAT_RGBA_102LE, SPA_VIDEO_FORMAT_BGRA_102LE, SPA_VIDEO_FORMAT_BGRA, SPA_VIDEO_FORMAT_BGRx};
+  for (const auto format : formats) {
+    for (const bool hdr : {false, true}) {
+      SCOPED_TRACE(::testing::Message() << "format=" << format << " hdr=" << hdr);
+      const bool expect_hdr = hdr && format != SPA_VIDEO_FORMAT_BGRA && format != SPA_VIDEO_FORMAT_BGRx;
+      const auto tags = pipewire::capture_color_tags(format, hdr);
+      EXPECT_EQ(tags.primaries, expect_hdr ? SPA_VIDEO_COLOR_PRIMARIES_BT2020 : SPA_VIDEO_COLOR_PRIMARIES_BT709);
+      EXPECT_EQ(static_cast<int>(tags.transfer), expect_hdr ? 14 : SPA_VIDEO_TRANSFER_GAMMA22);
+
+      // Parse the same builder output used in real format offers, not just the policy helper.
+      uint8_t buffer[256] {};
+      spa_pod_builder builder = SPA_POD_BUILDER_INIT(buffer, sizeof(buffer));
+      spa_pod_frame frame;
+      spa_pod_builder_push_object(&builder, &frame, SPA_TYPE_OBJECT_Format, SPA_PARAM_EnumFormat);
+      spa_pod_builder_add(&builder, SPA_FORMAT_mediaType, SPA_POD_Id(SPA_MEDIA_TYPE_video), SPA_FORMAT_mediaSubtype, SPA_POD_Id(SPA_MEDIA_SUBTYPE_raw), SPA_FORMAT_VIDEO_format, SPA_POD_Id(format), 0);
+      pipewire::add_capture_color_tags(&builder, format, hdr);
+      const auto pod = static_cast<spa_pod *>(spa_pod_builder_pop(&builder, &frame));
+      spa_video_info_raw parsed {};
+      ASSERT_GE(spa_format_video_raw_parse(pod, &parsed), 0);
+      EXPECT_EQ(parsed.color_primaries, tags.primaries);
+      EXPECT_EQ(parsed.transfer_function, tags.transfer);
+    }
+  }
+}
+#endif
